---
import Default from "@/layouts/default.astro";
import { Button } from "@/components/ui/button";
---

<Default title="sidneysilva.me - About me">
  <div class="flex flex-col gap-3">
    <h1 class="text-4xl">Sobre mi</h1>
    <p class="font-light text-lg dark:text-neutral-300">
      Simplemente una persona a la que le interesan los ordenadores, cómo funciona la economía y las finanzas personales. Ahora mismo, estoy estudiando un Grado Superior de Administración.
    </p>
  </div>
  <div class="flex flex-col gap-3 mt-6">
    <h1 class="text-4xl">Links</h1>
    <p class="font-light text-lg dark:text-neutral-300">
      Puedes seguirme y descubrir más sobre mi aquí:
    </p>
    <ul class="font-light text-lg dark:text-neutral-300 list-disc px-7 py-1">
      <li>
        Github:
        <a href="https://github.com/sxdny
            ">
          <Button
            className="p-0 text-lg underline dark:hover:text-lime-300 hover:text-lime-600  cursor-pointer"
            variant="link">@sxdny↗</Button
          >
        </a>
      </li>
      <li>
        Instagram:
        <a href="https://www.instagram.com/sidney_sbo/
            ">
          <Button
            className="p-0 text-lg underline dark:hover:text-lime-300 hover:text-lime-600  cursor-pointer"
            variant="link">@sidney_sbo↗</Button
          >

        </a>
      </li>
    </ul>
  </div>
</Default>
